GLOBAL_MAPPER_SCRIPT VERSION=1.00 LOG_ERRLOG_MESSAGES=YES
SET_LOG_FILE FILENAME="%logfile%" APPEND_TO_FILE=NO
LOG_MESSAGE ZONE80_BEGIN elevation_arc_ascii
UNLOAD_ALL
IMPORT FILENAME="%input%" TYPE=AUTO PROMPT_IF_TYPE_UNKNOWN=NO
EXPORT_ELEVATION FILENAME="%output%" TYPE=ARCASCIIGRID ELEV_UNITS=METERS
LOG_MESSAGE ZONE80_FINISHED elevation_arc_ascii
UNLOAD_ALL
