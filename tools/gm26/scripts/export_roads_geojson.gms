GLOBAL_MAPPER_SCRIPT VERSION=1.00 LOG_ERRLOG_MESSAGES=YES
SET_LOG_FILE FILENAME="%logfile%" APPEND_TO_FILE=NO
LOG_MESSAGE ZONE80_BEGIN roads_lines
UNLOAD_ALL
IMPORT FILENAME="%input%" TYPE=AUTO PROMPT_IF_TYPE_UNKNOWN=NO
EXPORT_VECTOR FILENAME="%output%" TYPE=GEOJSON SHAPE_TYPE=LINES OVERWRITE_EXISTING=NO
LOG_MESSAGE ZONE80_FINISHED roads_lines
UNLOAD_ALL
