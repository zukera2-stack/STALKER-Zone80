GLOBAL_MAPPER_SCRIPT VERSION=1.00 LOG_ERRLOG_MESSAGES=YES
SET_LOG_FILE FILENAME="%logfile%" APPEND_TO_FILE=NO
LOG_MESSAGE ZONE80_BEGIN buildings_footprints_only
UNLOAD_ALL
IMPORT FILENAME="%input%" TYPE=AUTO PROMPT_IF_TYPE_UNKNOWN=NO
EXPORT_VECTOR FILENAME="%output%" TYPE=GEOJSON SHAPE_TYPE=AREAS OVERWRITE_EXISTING=NO
LOG_MESSAGE ZONE80_FINISHED buildings_footprints_only
UNLOAD_ALL
